{
	"name": "n8n-nodes-lurkapi",
	"version": "0.1.1",
	"description": "n8n node for LurkAPI: public social media data as JSON from TikTok, Instagram, YouTube, Facebook, Reddit, LinkedIn, X, Google and more.",
	"license": "MIT",
	"homepage": "https://lurkapi.com",
	"keywords": [
		"n8n-community-node-package",
		"lurkapi",
		"social media",
		"scraper",
		"tiktok",
		"instagram",
		"youtube",
		"reddit",
		"ad library"
	],
	"author": {
		"name": "LurkAPI",
		"email": "support@lurkapi.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mesmerlord/n8n-nodes-lurkapi.git"
	},
	"scripts": {
		"generate": "node scripts/generate.mjs",
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --test test/*.test.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/LurkApiApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/LurkApi/LurkApi.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.57.4",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
